    "prestart": "vite build",
    "start": "node src/daemon/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/relay/cloudflare/tsconfig.json && tsc --noEmit -p src/web/tsconfig.json && tsc --noEmit -p src/web/tsconfig.sw.json && tsc --noEmit -p test/ui-polish/tsconfig.in-page.json",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot",
    "test:ci": "vitest run --reporter=verbose --reporter=github-actions --reporter=junit --outputFile.junit=vitest-junit.xml",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/relay/cloudflare/tsconfig.json && tsc --noEmit -p src/web/tsconfig.json && tsc --noEmit -p src/web/tsconfig.sw.json && tsc --noEmit -p test/ui-polish/tsconfig.in-page.json && vitest run --reporter=dot",
    "smoke": "node test/smoke/main.ts",
    "verify": "node scripts/verify-smoke.ts",
    "eval": "node test/eval/cli.ts",
    "ui:polish": "node test/ui-polish/cli.ts",
    "app:mac": "bash scripts/build-mac-app.sh"
  },
