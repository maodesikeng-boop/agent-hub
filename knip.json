{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/hub/main.ts",
    "src/feishu/main.ts",
    "src/mesh/main.ts",
    "src/web/sw.ts",
    "src/vendors/*/{daemon,paths}.ts",
    "scripts/*.ts",
    "src/web/bench/*.tsx",
    "test/smoke/{main,auto-renew,multi-vendor,skill-carryover}.ts",
    "test/eval/{cli,run.eval}.ts",
    "test/eval/fakes/{gh,record}.ts",
    "vitest.eval.config.ts",
    "test/fake-devices/main.ts"
  ],
  "ignore": [
    ".agents/**",
    "experiments/**",
    "apps/windows/crates/fusa-desktop/ui/**",
    "src/web/components/AppRail.tsx",
    "src/web/components/ComputerSwitcher.tsx",
    "src/web/components/ProfilePanel.tsx",
    "src/web/components/ProjectList.tsx",
    "src/web/components/SidePanel.tsx",
    "src/web/mobile/TabBar.tsx",
    "src/web/pane-widths.ts",
    "src/web/project-list.ts",
    "src/web/rail-model.ts",
    "src/web/shell-layout.ts",
    "src/web/side-panel.ts",
    "src/web/ui/resizable.tsx"
  ],
  "ignoreDependencies": [
    "@tauri-apps/cli",
    "oxlint",
    "oxlint-tsgolint"
  ],
  "ignoreBinaries": [
    "tar\\.exe",
    "reg\\.exe",
    "where\\.exe",
    "taskkill\\.exe",
    "subst\\.exe",
    "pwsh\\.exe",
    "mkfifo",
    "codex",
    "pi",
    "pi-bridge"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": [
    "duplicates"
  ]
}
