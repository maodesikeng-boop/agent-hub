# Keep LF line endings across platforms so Windows core.autocrlf=true never rewrites scripts or SQL migrations.
* text=auto eol=lf

*.sh text eol=lf
*.sql text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf

*.png binary
*.ico binary
*.icns binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wasm binary
*.gz binary
*.zip binary
*.exe binary
*.dll binary

.agents/skills/** linguist-vendored
.agents/skills/verify/** -linguist-vendored
