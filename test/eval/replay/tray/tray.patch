     // 数量在托盘标题上，顶栏不再重复
     expect(within(tray).getByRole("button", { name: /Needs You/ })).toHaveTextContent("4");
     expect(screen.getByRole("heading", { level: 1, name: "Router" }).closest("header")!.textContent).toBe("Router");
-    // 托盘和时间流、输入框左右对齐，最高半屏，超出在里面滚
